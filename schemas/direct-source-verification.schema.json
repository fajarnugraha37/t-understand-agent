{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/direct-source-verification.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "id",
    "retrieval_id",
    "snapshot_id",
    "status",
    "verified_claims",
    "errors",
    "generated_at"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/direct-source-verification.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^DSV-"
    },
    "retrieval_id": {
      "type": "string",
      "pattern": "^RET-"
    },
    "snapshot_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL"
      ]
    },
    "verified_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "status",
          "evidence_ids"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLM-"
          },
          "status": {
            "enum": [
              "VERIFIED",
              "UNSUPPORTED",
              "STALE",
              "CONFLICTED"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EVD-"
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
