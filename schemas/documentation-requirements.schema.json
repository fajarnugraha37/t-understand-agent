{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/documentation-requirements.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "docset_id", "model_id", "requirements", "generated_at"],
  "properties": {
    "schema_id": {"const": "https://t-understand.dev/schemas/documentation-requirements.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "docset_id": {"type": "string"},
    "model_id": {"type": "string"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "category", "document_id", "path", "audience", "source_models", "required_sections", "generation_mode", "scope"],
        "properties": {
          "requirement_id": {"pattern": "^DOCREQ-[A-F0-9]{16}$"},
          "category": {"enum": ["application", "business", "domain", "flows", "repositories", "integrations", "data", "operations", "reference"]},
          "document_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^[^/].*\\.md$"},
          "audience": {"enum": ["technical", "business", "mixed"]},
          "source_models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "required_sections": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "generation_mode": {"enum": ["catalog", "repository", "deep-flow", "standard-flow", "known-unknowns"]},
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repository_id": {"type": "string"},
              "flow_record_id": {"type": "string"},
              "flow_key": {"type": "string"}
            }
          }
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
