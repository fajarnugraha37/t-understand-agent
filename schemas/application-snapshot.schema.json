{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/application-snapshot.schema.json",
  "$comment": "Contract version 1.0.0; portable immutable application snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "snapshot_id", "application_id", "purpose", "status", "application_manifest_sha256", "workspace_resolution_sha256", "repositories", "content_digest", "captured_at"],
  "properties": {
    "schema_id": {"const": "https://t-understand.dev/schemas/application-snapshot.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,127}$"},
    "application_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "purpose": {"enum": ["foundation", "documentation", "qna", "review", "manual"]},
    "status": {"const": "CAPTURED"},
    "application_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workspace_resolution_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_id", "target_type", "resolved_commit", "descriptor_path", "descriptor_sha256", "content_digest"],
        "properties": {
          "repository_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "target_type": {"enum": ["branch", "tag", "commit", "head", "index", "worktree"]},
          "resolved_commit": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
          "descriptor_path": {"type": "string", "pattern": "^repositories/[a-z][a-z0-9-]{1,62}\\.yaml$"},
          "descriptor_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "captured_at": {"type": "string", "format": "date-time"}
  }
}
