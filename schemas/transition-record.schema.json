{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/transition-record.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "transition_id", "work_id", "workflow", "from_state",
    "to_state", "trigger", "actor", "source_id", "artifact_paths", "state_version_before",
    "state_version_after", "transitioned_at"
  ],
  "properties": {
    "schema_id": {"const": "https://t-understand.dev/schemas/transition-record.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "transition_id": {"type": "string", "pattern": "^TRN-[A-F0-9]{32}$"},
    "work_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "workflow": {"enum": ["foundation", "refresh", "documentation", "qna", "review"]},
    "from_state": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "to_state": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "trigger": {"enum": ["ROOT_COMPLETION", "WORKER_RESULT"]},
    "actor": {"const": "t-understand"},
    "source_id": {"type": ["string", "null"]},
    "artifact_paths": {"type": "array", "items": {"type": "string", "pattern": "^artifacts/"}},
    "state_version_before": {"type": "integer", "minimum": 1},
    "state_version_after": {"type": "integer", "minimum": 2},
    "transitioned_at": {"type": "string", "format": "date-time"}
  }
}
