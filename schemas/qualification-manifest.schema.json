{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/qualification-manifest.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "qualification_id",
    "status",
    "runner",
    "report_sha256",
    "generated_at",
    "content_digest"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/qualification-manifest.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "qualification_id": {
      "type": "string",
      "pattern": "^QUAL-"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "runner": {
      "const": "contract-simulator"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
