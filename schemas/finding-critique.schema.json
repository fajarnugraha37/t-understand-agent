{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/finding-critique.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "review_run_id",
    "status",
    "decisions",
    "generated_at"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/finding-critique.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "review_run_id": {
      "type": "string",
      "pattern": "^RVW-"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "decision",
          "reason"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^FND-"
          },
          "decision": {
            "enum": [
              "SURVIVED",
              "REJECTED",
              "NOT_REQUIRED"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
