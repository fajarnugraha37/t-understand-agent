{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/analysis-summary.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "analysis_id",
    "snapshot_id",
    "kind",
    "counts",
    "generated_at"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/analysis-summary.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "analysis_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "structural",
        "behavioral"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
