{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/model-manifest.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "model_id",
    "application_id",
    "snapshot_id",
    "memory_id",
    "status",
    "artifacts",
    "counts",
    "quality",
    "content_digest",
    "generated_at"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/model-manifest.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "model_id": {
      "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
    },
    "application_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "memory_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "CURRENT",
        "CONFLICTED",
        "STALE",
        "PARTIAL"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "records"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "records": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "traceability_coverage",
        "unsupported_records",
        "unknown_areas",
        "conflicts"
      ],
      "properties": {
        "traceability_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unsupported_records": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_areas": {
          "type": "integer",
          "minimum": 0
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "content_digest": {
      "pattern": "^[a-f0-9]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
