{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/severity-calibration.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "review_run_id",
    "status",
    "items",
    "generated_at"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/severity-calibration.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "review_run_id": {
      "type": "string",
      "pattern": "^RVW-"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "severity",
          "confidence",
          "rationale"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^FND-"
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "CRITICAL",
              "MAJOR",
              "MINOR",
              "TRIVIAL",
              "INFO"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
