{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/analysis-relation.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "id",
    "application_snapshot",
    "repository_id",
    "type",
    "source_entity",
    "target_key",
    "evidence",
    "classification",
    "confidence",
    "reasoning",
    "freshness"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/analysis-relation.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "pattern": "^REL-[A-F0-9]{16}$"
    },
    "application_snapshot": {
      "type": "string"
    },
    "repository_id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "CONTAINS",
        "DECLARES",
        "DEPENDS_ON",
        "CALLS",
        "EXPOSES",
        "READS",
        "WRITES",
        "PRODUCES",
        "CONSUMES",
        "VALIDATES",
        "THROWS",
        "USES_CONFIG",
        "TRANSACTION_BOUNDARY",
        "IMPLEMENTS",
        "TESTS"
      ]
    },
    "source_entity": {
      "pattern": "^ENT-"
    },
    "target_entity": {
      "pattern": "^ENT-"
    },
    "target_key": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "pattern": "^EVD-"
      }
    },
    "classification": {
      "enum": [
        "OBSERVED",
        "INFERRED"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "reasoning": {
      "type": "string",
      "minLength": 5
    },
    "freshness": {
      "enum": [
        "current",
        "stale",
        "unknown"
      ]
    }
  }
}
