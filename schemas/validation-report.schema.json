{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/validation-report.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "status",
    "checks",
    "errors"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/validation-report.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "checks": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
