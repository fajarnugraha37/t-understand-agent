{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/document-plan.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "docset_id",
    "model_id",
    "documents",
    "generated_at"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/document-plan.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "docset_id": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "path",
          "audience",
          "source_models"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "audience": {
            "enum": [
              "technical",
              "business",
              "mixed"
            ]
          },
          "source_models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
