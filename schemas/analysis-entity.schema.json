{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/analysis-entity.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "id",
    "application_snapshot",
    "repository_id",
    "kind",
    "name",
    "qualified_name",
    "path",
    "line",
    "evidence",
    "freshness"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/analysis-entity.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "pattern": "^ENT-[A-F0-9]{16}$"
    },
    "application_snapshot": {
      "type": "string"
    },
    "repository_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "qualified_name": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "detail": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "pattern": "^EVD-"
      }
    },
    "freshness": {
      "enum": [
        "current",
        "stale",
        "unknown"
      ]
    }
  }
}
