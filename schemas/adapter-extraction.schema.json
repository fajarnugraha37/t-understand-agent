{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://t-understand.dev/schemas/adapter-extraction.schema.json",
  "$comment":"Contract version 1.0.0",
  "type":"object","additionalProperties":false,
  "required":["schema_id","schema_version","extraction_id","snapshot_id","repository_id","path","file_sha256","adapter_id","adapter_version","language","status","declarations","dependencies","interfaces","configuration_keys","entry_points","limitations"],
  "properties":{
    "schema_id":{"const":"https://t-understand.dev/schemas/adapter-extraction.schema.json"},
    "schema_version":{"const":"1.0.0"},
    "extraction_id":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]{2,63}$"},
    "snapshot_id":{"type":"string"},
    "repository_id":{"type":"string"},
    "path":{"type":"string"},
    "file_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "adapter_id":{"type":"string"},
    "adapter_version":{"type":"string"},
    "language":{"type":["string","null"]},
    "status":{"enum":["COMPLETE","PARTIAL","UNSUPPORTED","SKIPPED"]},
    "declarations":{"type":"array","items":{"$ref":"#/$defs/item"}},
    "dependencies":{"type":"array","items":{"$ref":"#/$defs/item"}},
    "interfaces":{"type":"array","items":{"$ref":"#/$defs/item"}},
    "configuration_keys":{"type":"array","items":{"$ref":"#/$defs/item"}},
    "entry_points":{"type":"array","items":{"$ref":"#/$defs/item"}},
    "limitations":{"type":"array","items":{"type":"string"}}
  },
  "$defs":{"item":{"type":"object","additionalProperties":false,"required":["kind","name","line"],"properties":{"kind":{"type":"string"},"name":{"type":"string"},"line":{"type":"integer","minimum":1},"detail":{"type":"string"}}}}
}
