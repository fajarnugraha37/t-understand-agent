{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/delegation-packet.schema.json",
  "$comment": "Contract version 1.2.2; repository_intelligence and ponytail_context are optional for backward compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "invocation_id",
    "parent_agent",
    "target_agent",
    "delegation_depth",
    "workflow",
    "state",
    "state_version",
    "skill",
    "objective",
    "application_id",
    "application_snapshot",
    "permissions",
    "inputs",
    "outputs",
    "stop_conditions",
    "context_budget",
    "issued_at"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/delegation-packet.schema.json"
    },
    "schema_version": {
      "const": "1.2.0"
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^INV-[A-F0-9]{32}$"
    },
    "parent_agent": {
      "const": "t-understand"
    },
    "target_agent": {
      "type": "string",
      "pattern": "^tu-[a-z0-9-]+$"
    },
    "delegation_depth": {
      "const": 1
    },
    "workflow": {
      "enum": [
        "foundation",
        "refresh",
        "documentation",
        "qna",
        "review"
      ]
    },
    "state": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "skill": {
      "type": "string",
      "pattern": "^tu-[a-z0-9-]+$"
    },
    "objective": {
      "type": "string",
      "minLength": 20
    },
    "application_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "application_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "repository_intelligence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphify_status",
        "repository_root",
        "queries_performed",
        "findings",
        "affected_areas",
        "uncertainties",
        "verification_required"
      ],
      "properties": {
        "graphify_status": {
          "enum": [
            "available",
            "unavailable",
            "not_needed",
            "failed",
            "possibly_stale"
          ]
        },
        "repository_root": {
          "type": [
            "string",
            "null"
          ]
        },
        "queries_performed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity",
              "relationship",
              "evidence",
              "confidence"
            ],
            "properties": {
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "relationship": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        },
        "affected_areas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ponytail_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_outcome",
        "preserved_behavior",
        "change_required",
        "selected_solution",
        "alternatives_checked",
        "abstractions_approved",
        "dependencies_approved",
        "non_goals",
        "risks",
        "verification_required"
      ],
      "properties": {
        "required_outcome": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preserved_behavior": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "change_required": {
          "type": "boolean"
        },
        "selected_solution": {
          "type": "string",
          "minLength": 1
        },
        "alternatives_checked": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "no_code",
            "platform_native",
            "existing_repository_solution",
            "configuration_or_data",
            "localized_change"
          ],
          "properties": {
            "no_code": {
              "type": "string",
              "minLength": 1
            },
            "platform_native": {
              "type": "string",
              "minLength": 1
            },
            "existing_repository_solution": {
              "type": "string",
              "minLength": 1
            },
            "configuration_or_data": {
              "type": "string",
              "minLength": 1
            },
            "localized_change": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "abstractions_approved": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "current_justification"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "current_justification": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "dependencies_approved": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "current_justification"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "current_justification": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository_read",
        "source_repository_write",
        "git_mutation",
        "delegate",
        "artifact_write_domains"
      ],
      "properties": {
        "source_repository_read": {
          "const": "allow"
        },
        "source_repository_write": {
          "const": "deny"
        },
        "git_mutation": {
          "const": "deny"
        },
        "delegate": {
          "const": "deny"
        },
        "artifact_write_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_type",
          "path",
          "sha256"
        ],
        "properties": {
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_type",
          "path"
        ],
        "properties": {
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^artifacts/[a-z0-9-]+/INV-[A-F0-9]{32}-[a-z0-9-]+\\.yaml$"
          }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "context_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "one_primary_objective",
        "max_workers"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "evidence-slices",
            "bounded-evidence-packets",
            "expanded-evidence-packets"
          ]
        },
        "one_primary_objective": {
          "const": true
        },
        "max_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
