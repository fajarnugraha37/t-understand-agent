{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/review-finding.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "id",
    "review_snapshot",
    "type",
    "severity",
    "confidence",
    "location",
    "title",
    "observation",
    "evidence",
    "failure_scenario",
    "technical_impact",
    "recommendation",
    "required_verification",
    "critic_status"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/review-finding.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "pattern": "^FND-"
    },
    "review_snapshot": {
      "type": "string"
    },
    "type": {
      "enum": [
        "CORRECTNESS",
        "SECURITY",
        "DATA_INTEGRITY",
        "CONCURRENCY",
        "TRANSACTION",
        "RELIABILITY",
        "PERFORMANCE",
        "BREAKING_CHANGE",
        "API_COMPATIBILITY",
        "EVENT_COMPATIBILITY",
        "DATABASE_MIGRATION",
        "TEST_GAP",
        "DOCUMENTATION_GAP",
        "MAINTAINABILITY",
        "NITPICK"
      ]
    },
    "severity": {
      "enum": [
        "BLOCKER",
        "CRITICAL",
        "MAJOR",
        "MINOR",
        "TRIVIAL",
        "INFO"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "path",
        "start_line"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "minLength": 7
        },
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "title": {
      "type": "string"
    },
    "observation": {
      "type": "string",
      "minLength": 10
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^EVD-"
      }
    },
    "failure_scenario": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "technical_impact": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "business_impact": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation": {
      "type": "string",
      "minLength": 5
    },
    "required_verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "suggested_patch_path": {
      "type": "string"
    },
    "critic_status": {
      "enum": [
        "not-required",
        "pending",
        "challenged",
        "survived",
        "rejected"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "severity": {
            "enum": [
              "BLOCKER",
              "CRITICAL",
              "MAJOR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "critic_status": {
            "enum": [
              "challenged",
              "survived",
              "rejected"
            ]
          }
        }
      }
    }
  ]
}
