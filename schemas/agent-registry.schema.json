{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/agent-registry.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "required": [
    "contract",
    "agents"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "required": [
        "id",
        "version",
        "status"
      ]
    },
    "agents": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "purpose",
          "human_interaction",
          "can_delegate",
          "max_delegation_depth",
          "fresh_invocation"
        ]
      }
    }
  }
}
