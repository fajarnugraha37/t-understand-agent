{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/coverage-ledger.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "docset_id",
    "expected_documents",
    "generated_documents",
    "covered_model_records",
    "total_model_records",
    "coverage",
    "gaps",
    "generated_at"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/coverage-ledger.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "docset_id": {
      "type": "string"
    },
    "expected_documents": {
      "type": "integer",
      "minimum": 0
    },
    "generated_documents": {
      "type": "integer",
      "minimum": 0
    },
    "covered_model_records": {
      "type": "integer",
      "minimum": 0
    },
    "total_model_records": {
      "type": "integer",
      "minimum": 0
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
