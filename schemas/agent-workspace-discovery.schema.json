{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/agent-workspace-discovery.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "workspace_root", "workspace_model", "mode", "prompt_requested_multi_repo", "repositories", "generated_at"],
  "properties": {
    "schema_id": {"const": "https://t-understand.dev/schemas/agent-workspace-discovery.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "workspace_root": {"type": "string", "minLength": 1},
    "workspace_model": {"enum": ["single-repo", "multi-repo"]},
    "mode": {"enum": ["existing-application", "prompt-expanded-siblings", "current-git-root", "workspace-scan"]},
    "prompt_requested_multi_repo": {"type": "boolean"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_id", "name", "path", "role", "identity_kind", "identity_value", "remote", "inclusion_reason", "confidence", "markers"],
        "properties": {
          "repository_id": {"pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "identity_kind": {"enum": ["remote", "explicit"]},
          "identity_value": {"type": "string", "minLength": 1},
          "remote": {"type": ["string", "null"]},
          "inclusion_reason": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["high", "medium", "low"]},
          "markers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
