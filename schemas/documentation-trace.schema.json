{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/documentation-trace.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "docset_id",
    "document_id",
    "section_id",
    "model_record_ids",
    "claim_ids",
    "evidence_ids",
    "generated_at"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/documentation-trace.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "docset_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "section_id": {
      "type": "string"
    },
    "model_record_ids": {
      "type": "array",
      "items": {
        "pattern": "^MODREC-"
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "pattern": "^CLM-"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "pattern": "^EVD-"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
