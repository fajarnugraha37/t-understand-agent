{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://t-understand.dev/schemas/adapter-manifest.schema.json",
  "$comment":"Contract version 1.0.0",
  "type":"object","additionalProperties":false,
  "required":["schema_id","schema_version","id","version","priority","languages","file_patterns","capabilities","fallback","implementation"],
  "properties":{
    "schema_id":{"const":"https://t-understand.dev/schemas/adapter-manifest.schema.json"},
    "schema_version":{"const":"1.0.0"},
    "id":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "priority":{"type":"integer","minimum":0,"maximum":1000},
    "languages":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "file_patterns":{"type":"array","items":{"type":"string"}},
    "capabilities":{"type":"object","additionalProperties":{"enum":["none","detect","surface","structured"]}},
    "fallback":{"type":"boolean"},
    "implementation":{"type":"string","pattern":"^tu_runtime\\.adapters\\.[A-Za-z0-9_.:]+$"}
  }
}
