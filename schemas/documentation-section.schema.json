{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/documentation-section.schema.json",
  "$comment": "Contract version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "document_id",
    "section_id",
    "title",
    "classification",
    "application_snapshot",
    "content",
    "claims",
    "evidence",
    "freshness",
    "coverage"
  ],
  "properties": {
    "schema_id": {
      "const": "https://t-understand.dev/schemas/documentation-section.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "type": "string"
    },
    "section_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "TECHNICAL_FACT",
        "IMPLEMENTED_BEHAVIOR",
        "BUSINESS_INFERENCE",
        "HUMAN_CONFIRMED_RULE",
        "UNKNOWN_INTENT",
        "LIMITATION"
      ]
    },
    "application_snapshot": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "minLength": 10
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CLM-"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVD-"
      }
    },
    "freshness": {
      "enum": [
        "current",
        "stale",
        "unknown"
      ]
    },
    "coverage": {
      "enum": [
        "complete-for-declared-scope",
        "partial",
        "unknown"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "enum": [
              "TECHNICAL_FACT",
              "IMPLEMENTED_BEHAVIOR",
              "BUSINESS_INFERENCE",
              "HUMAN_CONFIRMED_RULE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "claims": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
