{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-understand.dev/schemas/workspace-resolution.schema.json",
  "$comment": "Contract version 1.0.0; runtime-local resolution output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "application_id", "workspace_model", "machine_id", "manifest_sha256", "status", "repositories", "resolved_at"],
  "properties": {
    "schema_id": {"const": "https://t-understand.dev/schemas/workspace-resolution.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "application_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "workspace_model": {"enum": ["single-repo", "monorepo", "multi-repo"]},
    "machine_id": {"type": "string", "minLength": 2},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "RESOLVED"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_id", "local_path", "git_root", "identity_type", "expected_identity", "actual_identity", "identity_status", "source_access"],
        "properties": {
          "repository_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "local_path": {"type": "string", "minLength": 1},
          "git_root": {"type": "string", "minLength": 1},
          "identity_type": {"enum": ["remote", "explicit"]},
          "expected_identity": {"type": "string", "minLength": 1},
          "actual_identity": {"type": ["string", "null"]},
          "identity_status": {"enum": ["MATCH", "EXPLICIT"]},
          "source_access": {"const": "READ_ONLY"}
        }
      }
    },
    "resolved_at": {"type": "string", "format": "date-time"}
  }
}
