{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://t-understand.dev/schemas/application-discovery.schema.json",
  "$comment":"Contract version 1.0.0",
  "type":"object","additionalProperties":false,
  "required":["schema_id","schema_version","discovery_id","application_id","snapshot_id","snapshot_digest","status","repositories","coverage","content_digest","generated_at"],
  "properties":{
    "schema_id":{"const":"https://t-understand.dev/schemas/application-discovery.schema.json"},
    "schema_version":{"const":"1.0.0"},
    "discovery_id":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]{2,63}$"},
    "application_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,62}$"},
    "snapshot_id":{"type":"string","minLength":1},
    "snapshot_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "status":{"const":"DISCOVERED"},
    "repositories":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["repository_id","descriptor_path","descriptor_sha256","content_digest"],"properties":{"repository_id":{"type":"string"},"descriptor_path":{"type":"string"},"descriptor_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"content_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
    "coverage":{"type":"object","additionalProperties":false,"required":["repositories_total","repositories_discovered","files_total","included","excluded"],"properties":{"repositories_total":{"type":"integer","minimum":1},"repositories_discovered":{"type":"integer","minimum":1},"files_total":{"type":"integer","minimum":0},"included":{"type":"integer","minimum":0},"excluded":{"type":"integer","minimum":0}}},
    "content_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "generated_at":{"type":"string","format":"date-time"}
  }
}
